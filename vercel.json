{
  "regions": ["sin1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(claudebot|gptbot|chatgpt-user|ccbot).*"
        }
      ],
      "destination": "https://http.cat/403",
      "permanent": false
    }
  ]
}
